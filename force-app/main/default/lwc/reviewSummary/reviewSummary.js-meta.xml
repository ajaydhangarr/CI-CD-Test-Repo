<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Review Summary</masterLabel>
    <description>Read-only workflow review summary that maps JSON keys to configured field labels.</description>
    <targets>
        <target>lightning__FlowScreen</target>
        <target>lightning__AppPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="workflowType" type="String" label="Workflow Type" role="inputOnly" />
            <property name="formDataJson" type="String" label="Form Data JSON" role="inputOnly" />
            <property name="fieldConfigJson" type="String" label="Field Configuration JSON" role="inputOnly" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
