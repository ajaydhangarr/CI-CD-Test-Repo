                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Warranty_Step1</targetReference>
            </connector>
            <label>Warranty Claim</label>
        </rules>
    </decisions>
    <description>Reusable multi-step workflow platform using Screen Flow and dynamic LWC rendering.</description>
