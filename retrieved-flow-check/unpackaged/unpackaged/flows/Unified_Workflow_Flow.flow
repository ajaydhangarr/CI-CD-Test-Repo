    <decisions>
        <name>Validate_Customer_Address</name>
        <label>Validate Customer Address</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Customer_Address_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Invalid</defaultConnectorLabel>
        <rules>
            <name>Customer_Address_Valid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isStepValid</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Persist_Customer_Step2</targetReference>
            </connector>
            <label>Valid</label>
        </rules>
    </decisions>
